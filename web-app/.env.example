# Copy to web-app/.env.local. Never commit real values.
# VITE_* variables are inlined into the browser bundle at build time, so none of
# these are secrets - but the values must match the core API's .env exactly.

# Auth0 application Domain, bare host with no scheme or trailing slash.
# Same value as AUTH0_DOMAIN in the root .env.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 Single Page Application Client ID. Frontend only; the core API
# validates tokens and never authenticates as the application.
VITE_AUTH0_CLIENT_ID=

# Auth0 API Identifier. Same value as AUTH0_AUDIENCE in the root .env.
# A mismatch logs in fine and then fails every API call with 401.
VITE_AUTH0_AUDIENCE=https://api.billguard.dev

VITE_API_URL=http://localhost:3001
