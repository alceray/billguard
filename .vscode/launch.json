{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BillGuard: Run app",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "windows": {
        "runtimeExecutable": "npm.cmd"
      },
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web-app",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "BillGuard: Docker Compose Up",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^\\s\\u001b]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
