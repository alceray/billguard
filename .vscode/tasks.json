{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BillGuard: Docker Compose Up",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "--build", "-d"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BillGuard: Docker Compose Down",
      "type": "process",
      "command": "docker",
      "args": ["compose", "down"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
