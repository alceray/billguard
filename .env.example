# Copy to .env for Docker Compose. Never commit real values.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.billguard.dev
DATABASE_USER=billguard
DATABASE_PASSWORD=billguard_dev
DATABASE_URL=postgresql://billguard:billguard_dev@postgres:5432/billguard
LOCAL_LLM_MODE=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=4096
BILLGUARD_DETECTION_MAX_CLASSIFICATIONS_PER_RUN=25
OPENAI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
